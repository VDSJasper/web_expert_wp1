doctype html
html
    head
        title wp1
    body
        h1 #{title}

        each routeName, i in routeNames
            a(href=`/${routeName}`) #{routeName}
            ul
                each route in routes[i]
                    li: a(href=`/${routeName}/${route.id}`)= route.name
            if relationships[routeName]
                a(href=`/${routeName}/?embed=owners`) #{routeName} with embedding
                ul
                    each route in routes[i]
                        li: a(href=`/${routeName}/${route.id}?embed=owners`)= route.name
